<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+: asked after login, never blocks the app if denied. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Add property: GPS address while using the app + live photos. No gallery / storage permissions. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />


    <application
        android:name=".SafeRentApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeRent">
        <!-- Rent receipt PDFs → other apps (PDF viewer, Share) via content:// uris. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SafeRent.Starting"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links: shared listing / invite / property links open the app (App Links once
                 /.well-known/assetlinks.json is on the site; until then Android 12+ opens the link in the browser). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="saferenttechnologies.com" />
                <data android:host="dev.saferenttechnologies.com" />
                <data android:host="app.saferenttechnologies.com" />
                <!-- Exactly the backend's list: no http, no wildcard host, no "/" (one unverifiable
                     host / path drops verification for the whole filter). -->
                <data android:pathPrefix="/homes/" />
                <data android:path="/browse" />
                <data android:pathPrefix="/invite/" />
                <!-- Property / flat QR stickers: /p/{propertyCode} and /p/{propertyCode}/u/{unitCode}. -->
                <data android:pathPrefix="/p/" />
                <data android:pathPrefix="/properties/" />
                <data android:path="/applications" />
                <data android:pathPrefix="/leases/" />
                <data android:path="/notifications" />
                <!-- DigiLocker (owner verification) returns here. -->
                <data android:path="/app/kyc/return" />
            </intent-filter>

            <!-- saferent://homes/{id} etc. (QR codes, SMS, other apps) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="saferent" />
            </intent-filter>
        </activity>

        <!-- FCM: background notifications use our channel + icon -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="saferent_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notifications" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/splash_background" />

        <service
            android:name=".data.push.SafeRentMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>