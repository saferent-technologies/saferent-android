<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: what Google backup / phone-to-phone transfer may copy.
    App settings (DataStore: onboarding seen, permission prompts asked, drafts, DigiLocker session…)
    are NOT restored on a new install: a reinstall starts fresh (onboarding shows again, Android's
    permission dialogs aren't mistaken for "blocked").
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
